# Fictional local demo. If POSTGRES_PASSWORD changes, also change DATABASE_URL.
DATABASE_URL=postgresql://waterline:waterline@localhost:5433/waterline_live
POSTGRES_PASSWORD=waterline
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=water_knowledge
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
WATERLINE_API_URL=http://localhost:8000

# Browser spoken replies: Azure Neural TTS, Ava voice by default.
AZURE_SPEECH_ENDPOINT=https://germanywestcentral.api.cognitive.microsoft.com/
AZURE_SPEECH_KEY=

# Phone interfaces. Configure the existing public HTTPS tunnel origin (no path).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
TWILIO_PHONE_NUMBER=

# Outbound demo: only this explicitly consenting, allowlisted recipient is dialed on C.
DEMO_CALLEE_NUMBER=
DEMO_ALLOWED_NUMBERS=
# Optional existing PostgreSQL asset UUID; leave blank for a generic introduction.
DEMO_OPENING_PIPE_ID=
# Optional message following the AI introduction, used only without a contextual asset.
DEMO_OPENING_MESSAGE=
# Outbound ConversationRelay TTS. Inbound calls keep the existing Azure voice.
TWILIO_RELAY_TTS_PROVIDER=Google
TWILIO_RELAY_VOICE=
# To use ElevenLabs: set provider=ElevenLabs and a supported ConversationRelay voice ID.
# Local demo only; off by default because transcripts may contain private information.
VOICE_DEBUG_TRANSCRIPTS=0
